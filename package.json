{
	"name": "editorjs-dnd",
	"version": "0.2.0",
	"description": "A drag and drop plugin for Editor.js",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"unpkg": "./dist/index.global.js",
	"jsdelivr": "./dist/index.global.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs",
			"default": "./dist/index.global.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"lint": "biome lint .",
		"lint:fix": "biome lint . --fix",
		"format": "biome format --write .",
		"test": "vitest run",
		"test:watch": "vitest watch",
		"test:coverage": "vitest run --coverage",
		"changeset": "changeset"
	},
	"keywords": [
		"editorjs",
		"editor.js",
		"editorjs-plugin",
		"drag-and-drop",
		"dnd",
		"typescript"
	],
	"repository": "https://github.com/ozimmortal/editorjs-dnd",
	"author": "Oliyad Zelalem Abdena",
	"license": "MIT",
	"packageManager": "pnpm@10.33.4",
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.1",
		"@editorjs/editorjs": "^2.31.6",
		"jsdom": "^30.0.1",
		"tsup": "^8.5.1",
		"typescript": "^5.7.3",
		"vitest": "^4.1.11"
	}
}
